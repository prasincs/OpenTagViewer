<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bridge_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="?attr/colorSurface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/bridge_title" android:textAppearance="?attr/textAppearanceHeadlineMedium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/bridge_about" />
        <TextView android:id="@+id/bridge_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:id="@+id/bridge_setup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="16dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/bridge_scan"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bridge_scan" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/bridge_scan_help" android:layout_marginBottom="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/bridge_import"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bridge_import" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/bridge_pairing" android:layout_marginTop="16dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/bridge_pairing"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"
                    android:saveEnabled="false" android:importantForAutofill="no" android:filterTouchesWhenObscured="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/bridge_connect"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bridge_connect" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bridge_dashboard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton android:id="@+id/bridge_refresh"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/bridge_refresh" />
                <com.google.android.material.button.MaterialButton android:id="@+id/bridge_disconnect"
                    style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/bridge_disconnect" />
            </LinearLayout>
            <FrameLayout android:id="@+id/bridge_map" android:layout_width="match_parent" android:layout_height="260dp" />
            <LinearLayout android:id="@+id/bridge_items" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="12dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/bridge_direct"
            style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/bridge_direct" />
    </LinearLayout>
</ScrollView>
